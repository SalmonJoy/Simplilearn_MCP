# Local credentials and environment overrides; keep the setup template.
.env
.env.*
!.env.example

# Streamlit theme is tracked; local secrets never are.
**/.streamlit/secrets.toml

# Python virtual environments and compiled files.
.venv/
venv/
__pycache__/
*.py[cod]

# Test, lint, type-check and coverage artifacts.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
test-results/
junit*.xml

# Python packaging output.
build/
dist/
*.egg-info/
.eggs/

# Local logs, downloaded tooling and optional Node dependencies.
.logs/
logs/
*.log
node_modules/
*.pid
*.pid.lock
nohup.out

# Local MongoDB backups and exported data, not application seed code.
/dump/
/mongodump/
/exports/

# Machine-specific assistant settings; keep shared skills versionable.
.claude/settings.local.json

# Installed Streamlit skill links point into this machine's ignored .venv.
/.agents/skills/developing-with-streamlit
/.claude/skills/developing-with-streamlit

# Personal editor settings, temporary files and OS metadata.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
