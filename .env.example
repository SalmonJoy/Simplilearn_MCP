# Copy to .env, then fill credentials. Never commit .env.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mcp_learning
# If using Atlas, put percent-encoded credentials directly in MONGODB_URI.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
HRMS_URL=http://127.0.0.1:8001
INVENTORY_URL=http://127.0.0.1:8002
MCP_URL=http://127.0.0.1:8003/mcp
